<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CimonPlc</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Cimon.Net</PackageId>
    <Version>2.0.0</Version>
    <Authors>Mojtaba Kiani</Authors>
    <Product>Cimon.Net</Product>
    <Description>A .NET Library for Cimon PLCs Connectivity over Ethernet (TCP) and Serial (RS232C/RS485)</Description>
    <PackageTags>Cimon;PLC;Industrial;Automation;Ethernet;Serial</PackageTags>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MojtabaKiani/Cimon.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MojtabaKiani/Cimon.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>See https://github.com/MojtabaKiani/Cimon.Net/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CimonPlc.UnitTests" />
  </ItemGroup>

</Project>
